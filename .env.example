# Tzij configuration. Copy to .env (never commit .env). The Makefile loads it.
# No model name is hard-coded in the code: every model comes from here.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
GOOGLE_CLOUD_LOCATION=global
REGION=us-central1
# Pipeline outputs (datasets/<version>/) and raw cache (raw/) live here.
DATA_BUCKET_URI=gs://ai-experiments-487722-tzij-data
MODELS_BUCKET_URI=gs://ai-experiments-487722-tzij-models

# --- Models ---
# Goliath (and eval judge). Never used to generate K'iche' data.
GEMINI_MODEL=gemini-3.8-flash
# Hugging Face id of the base Gemma: tokenizer for fertility, base for fine-tuning.
GEMMA_BASE_MODEL=google/gemma-4-E2B-it
# Ollama tag David runs on the laptop (base or fine-tuned).
LOCAL_MODEL_TAG=gemma4:e2b-it-qat
# Ollama embedding model for the retrieval index (index and queries must match).
EMBEDDING_MODEL=embeddinggemma

# --- Local services ---
OLLAMA_HOST=http://localhost:11434
# Retrieval index built by `make index`.
RAG_INDEX=rag/index/tzij.sqlite

# 1 = tests and rehearsals without cloud calls.
MOCK_AI=0
