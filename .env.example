# Tzij configuration. Copy to .env (never commit .env). The Makefile loads it.
# No model name is hard-coded in the code: every model comes from here.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
GOOGLE_CLOUD_LOCATION=global
REGION=us-central1
# Pipeline outputs (datasets/<version>/) and raw cache (raw/) live here.
DATA_BUCKET_URI=gs://ai-experiments-487722-tzij-data
MODELS_BUCKET=gs://ai-experiments-487722-tzij-models

# --- Models ---
# Goliath. Also the teacher for training-only data (back-translation, distillation); never for the
# dataset, the retrieval index, dev or test.
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x reasoning level; "low" keeps a one-line translation fast.
GEMINI_THINKING_LEVEL=low
# USD per 1M tokens (standard tier; thinking tokens are billed as output).
# Until 2026-12-31: 0.75 / 3.75. From 2027-01-01 the list price doubles: 1.50 / 7.50.
GEMINI_INPUT_USD_PER_M=0.75
GEMINI_OUTPUT_USD_PER_M=3.75
# The announced price from that day on ("YYYY-MM-DD:input/output"); the page uses the price of the day.
GEMINI_NEXT_PRICE=2027-01-01:1.50/7.50
# Base Gemma checkpoint for fine-tuning (E4B: the best base in evals/report.md); its tokenizer
# (google/<name>) is also what evals/fertility.py measures.
GEMMA_BASE_MODEL=gemma-4-E4B-it
# The Ollama tag David's GPU service serves (infra/20-david.sh bakes it into the image from MODELS_BUCKET);
# David always adds retrieval. Chosen from evals/report.md (run final-20261002): 2-epoch RAFT LoRA on E4B
# continued with Bloom back-translation (both ways) and distillation, with hybrid retrieval and MBR-4;
# specialty test, the Firefox Focus translation memory (evals/niche_results.md): 37.4 vs Goliath 28.9.
LOCAL_MODEL_TAG=tzij-2026-10-mix-s7
# Ollama models compared in `make eval` (each with and without retrieval). They must be in David's image:
# the evals run against the cloud David (make david-proxy). Past runs of other models stay in evals/runs/.
BASE_MODEL_TAGS=
# Ablation rows in evals/report.md, in order (label=variant;...).
ABLATION_STEPS=base + vector retrieval=gemma4:e4b+rag;+ hybrid retrieval (BM25+vectors, tuned on dev)=gemma4:e4b+hybrid;+ RAFT with Gemini back-translation (1 epoch)=tzij-2026-10-raft-bt-s3+hybrid;+ MBR (4 samples)=tzij-2026-10-raft-bt-s3+hybrid+mbr4;+ niche-clean data, 2 epochs, Bloom back-translation and distillation=tzij-2026-10-mix-s7+hybrid+mbr4
# Pairs per test source and direction in `make eval` (stable sample; 0 = the whole test set).
EVAL_PER_SOURCE=150
# Fine-tuned tags compared in `make eval`: the demo's David (2 epochs RAFT on the niche-clean data + Bloom
# back-translation both ways + distillation in the test's domains; never saw Firefox Focus). The earlier
# tags (tzij-2026-10-raft-bt-s3, the -s0 ablation) are measured in evals/runs/final-20261002.
FINETUNED_MODEL_TAGS=tzij-2026-10-mix-s7
# Ollama embedding model for the retrieval index (index and queries must match).
EMBEDDING_MODEL=embeddinggemma

# --- David's Ollama ---
# Inside David's GPU service, Ollama listens here. On a laptop the Makefile points OLLAMA_URL at
# `make david-proxy` instead (port DAVID_PROXY_PORT, 11435): the measurements use the cloud David.
OLLAMA_URL=http://127.0.0.1:11434
# Context window for Gemma in Ollama. The 128k default is slow and evicts EmbeddingGemma.
OLLAMA_NUM_CTX=4096
# Retrieval index built by `make index`, and how many examples/glossary entries David gets.
RAG_INDEX=rag/index/tzij.sqlite
RAG_K=6
# Tuned on the dev split (make tune-retrieval -> evals/tuning.md): hybrid BM25 + EmbeddingGemma,
# fuzzy dictionary lookup, closest example last.
RAG_MODE=hybrid
RAG_ORDER=best_last
RAG_FUZZY=1
# MBR decoding: samples per translation for the "+mbrN" eval variant (0 = off). DAVID_MBR=1: David's
# service uses it for every translation on the page.
MBR_SAMPLES=4
DAVID_MBR=1

# --- The demo page ---
# Set by infra/21-page.sh on Cloud Run: David's private GPU service. Empty = David in the same process (tests).
DAVID_URL=
# David's GPU service shape (infra/20-david.sh) and its Cloud Run prices in europe-west4 (instance-based
# billing, L4 without zonal redundancy; Cloud Billing catalog, 2026-10-07). The page shows David's cost
# per translation as the seconds he worked × the instance's price per second.
DAVID_CPU=4
DAVID_MEMORY_GIB=16
DAVID_GPU_USD_PER_S=0.0001867
DAVID_VCPU_USD_PER_S=0.000018
DAVID_GIB_USD_PER_S=0.000002

# --- Fine-tuning (Cloud Run Job, 1x L4, europe-west4; see train/ and infra/03-train-job.sh) ---
TRAIN_RUNTIME=cloud-run
TRAIN_REGION=europe-west4
# Weights from Hugging Face with the hf-token secret (Gemma terms accepted).
GEMMA_WEIGHTS_URI=hf://google
# Ollama RENDERER/PARSER of the base family, written into the fine-tuned model's Modelfile.
OLLAMA_RENDERER=gemma4
# E4B (16 GB) + an f16 GGUF don't fit in Cloud Run's 32 GiB in-memory disk: the training job converts via q8_0.
GGUF_OUTTYPE=q8_0
# GGUF quantization David is served with (Ollama on his GPU service).
QUANT=Q4_K_M
# later = the GPU job only trains the adapter: E4B's merge doesn't fit the Cloud Run CPU finish job, so it's
# finished with `make train-finish TAG=...` on a Cloud Batch VM with 64 GB (infra/04-finish-batch.sh).
TRAIN_FINISH=later
# Only used with TRAIN_RUNTIME=vertex.
TRAIN_MACHINE=g2-standard-8
TRAIN_ACCELERATOR=NVIDIA_L4
TRAIN_SCHEDULING=STANDARD
TRAIN_HOURLY_USD=1.10
STAGING_BUCKET=gs://ai-experiments-487722-train-eu

# --- Hugging Face (gated BOUQuET and Gemma downloads) ---
# Leave empty to read Secret Manager secret `hf-token`; never commit a token.
HF_TOKEN=

# 1 = tests and rehearsals without cloud calls.
MOCK_AI=0
